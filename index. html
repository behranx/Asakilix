<!DOCTYPE html>
<html lang="fa">
<head>
<meta charset="UTF-8">
<title>نمایش تئاتر + دکمه اضطراری</title>
<style>
    body {
        margin: 0;
        padding: 0;
        background: #111;
        overflow: hidden;
        font-family: sans-serif;
        direction: rtl;
    }

    /* سالن */
    .theater {
        position: relative;
        width: 100vw;
        height: 100vh;
        background: #222;
    }

    /* پرده */
    .curtain {
        position: absolute;
        width: 100%;
        height: 100%;
        background: linear-gradient(to right, #8b0000, #b30000, #8b0000);
        transform-origin: top;
        transform: translateY(0);
        transition: transform 2s ease-in-out;
        z-index: 10;
    }

    .curtain.open {
        transform: translateY(-100%);
    }

    /* متن زیر پرده */
    .message {
        position: absolute;
        top: 40%;
        width: 100%;
        text-align: center;
        color: #fff;
        font-size: 3rem;
        opacity: 0;
        transition: opacity 1s ease-in-out 1s;
    }
    .message.show {
        opacity: 1;
    }

    /* دکمه امرجنسی */
    .emergency-btn {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 120px;
        background: radial-gradient(circle, #ff3b3b, #b30000);
        border-radius: 50%;
        border: 6px solid #660000;
        box-shadow: 0 0 25px red;
        cursor: pointer;
        z-index: 20;
    }

    .counter {
        position: absolute;
        bottom: 170px;
        width: 100%;
        text-align: center;
        font-size: 4rem;
        color: yellow;
        opacity: 0;
        transition: opacity .3s;
    }

    /* کاغذ رنگی */
    .confetti {
        position: fixed;
        top: -10px;
        width: 10px;
        height: 15px;
        background: red;
        opacity: 0.8;
        animation: fall linear forwards;
    }

    @keyframes fall {
        to {
            transform: translateY(110vh) rotate(360deg);
        }
    }
</style>
</head>

<body>

<div class="theater">
    <div class="curtain" id="curtain"></div>

    <div class="message" id="message">
        فردا شب  مجلل می‌بینمت اسکول جون
    </div>

    <div class="counter" id="counter"></div>

    <div class="emergency-btn" id="btn"></div>
</div>

<script>
    const btn = document.getElementById("btn");
    const counterEl = document.getElementById("counter");
    const curtain = document.getElementById("curtain");
    const message = document.getElementById("message");

    btn.addEventListener("click", () => {
        let t = 5;
        counterEl.style.opacity = 1;
        counterEl.textContent = t;

        const interval = setInterval(() => {
            t--;
            counterEl.textContent = t;
            if (t === 0) {
                clearInterval(interval);
                counterEl.style.opacity = 0;

                // کاغذ رنگی
                for (let i = 0; i < 150; i++) {
                    createConfetti();
                }

                // پرده بالا بره
                curtain.classList.add("open");

                // متن ظاهر شود
                setTimeout(() => {
                    message.classList.add("show");
                }, 1500);
            }
        }, 1000);
    });

    function createConfetti() {
        const c = document.createElement("div");
        c.className = "confetti";
        document.body.appendChild(c);

        const colors = ["#ff3838", "#ff9f1a", "#fff200", "#32ff7e", "#18dcff", "#7d5fff", "#ff4d4d"];
        c.style.background = colors[Math.floor(Math.random() * colors.length)];
        c.style.left = Math.random() * 100 + "vw";
        c.style.animationDuration = (2 + Math.random() * 3) + "s";

        setTimeout(() => c.remove(), 6000);
    }
</script>

</body>
</html>
